{
  "name": "cbt-backend",
  "version": "1.0.0",
  "description": "CBT Backend",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "typeorm": "tsx -r reflect-metadata node_modules/typeorm/cli.js -d src/data-source.ts",
    "migration:generate": "npm run typeorm migration:generate src/migrations/InitialMigration",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.7.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.1",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "twilio": "^6.1.0",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/helmet": "^0.0.48",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.10",
    "@types/redis": "^4.0.10",
    "@types/socket.io": "^3.0.1",
    "@types/winston": "^2.4.4",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
