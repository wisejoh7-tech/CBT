# Backend Web Service Environment Variables

# Node Environment (development | production)
NODE_ENV=development

# Server Port
PORT=10000

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/cbt_db

# Individual Database Parameters (Alternative to DATABASE_URL)
DB_HOST=localhost
DB_USER=postgres
DB_PASS=password
DB_NAME=cbt_db
DB_PORT=5432

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed Admin Account Credentials
INITIAL_ADMIN_EMAIL=admin@vivicbt.com
INITIAL_ADMIN_PASSWORD=admin123
INITIAL_ADMIN_NAME=System Master

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379

# AI & Gemini API (Optional)
GEMINI_API_KEY=your_gemini_api_key

# Email Sending - Resend (Optional)
RESEND_API_KEY=re_123456789
RESEND_FROM_EMAIL=VIVI CBT Support <onboarding@resend.dev>

# Email Sending - SMTP (Optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password

# Twilio SMS Services (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Firebase Admin SDK Configuration (Optional)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"
