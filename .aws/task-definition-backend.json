{
    "family": "cbt-backend",
    "networkMode": "awsvpc",
    "containerDefinitions": [
        {
            "name": "cbt-backend",
            "image": "REPLACE_WITH_IMAGE_URI",
            "portMappings": [
                {
                    "containerPort": 5000,
                    "hostPort": 5000,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "environment": [
                { "name": "NODE_ENV", "value": "production" },
                { "name": "DATABASE_URL", "value": "REPLACE_WITH_MANAGED_POSTGRES_DATABASE_URL" }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/cbt-backend",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": [ "FARGATE" ],
    "cpu": "256",
    "memory": "512"
}
